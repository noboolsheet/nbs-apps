#--- DOCKER (perfil demo: datos FICTICIOS, público por Caddy) ---#
DOCKER_PROFILE="demo"
DOCKER_NETWORK="noboolsheet_network"
# Caddy alcanza estos contenedores por nombre dentro de noboolsheet_network
# (`reverse_proxy unilp.app.demo:80`), así que el puerto publicado es sólo para
# depurar y para `tailscale funnel`. 0.0.0.0 = LAN de casa + tailnet.
DOCKER_IFACE="0.0.0.0"

#--- BASE DE DATOS COMPARTIDA (nbs-db, en el repo nbs-infra) ---#
# control-tower ya no lleva Postgres propio: usa la database `control_tower`
# dentro de nbs-db, el único cluster del servidor. Se despliega desde
# nbs-infra/postgres/deploy-postgres.sh demo, ANTES que esta app.
DOCKER_NBS_DB_DDNS="nbs-db"
# Red dedicada a la base de datos, separada de noboolsheet_network y distinta
# por perfil: sólo la comparten nbs-db y quien necesita base de datos.
DOCKER_DB_NETWORK="noboolsheet_db_demo"

#--- UNILP (web de muestra: Next.js exportado estático → nginx) ---#
DOCKER_UNILP_APP_DDNS="unilp.app"
UNILP_APP_EPORT="4214"
UNILP_APP_IPORT="80"
UNILP_APP_IFACE="${DOCKER_IFACE}"

#--- UTCS (web de muestra: SSR; formularios y chatbot desactivados) ---#
DOCKER_UTCS_APP_DDNS="utcs.app"
UTCS_APP_EPORT="4224"
UTCS_APP_IPORT="80"
UTCS_APP_IFACE="${DOCKER_IFACE}"

#--- CV-CREATOR (demo pública) ---#
DOCKER_CV_CREATOR_APP_DDNS="cv-creator.app"
CV_CREATOR_APP_EPORT="4244"
CV_CREATOR_APP_IPORT="3000"
CV_CREATOR_APP_IFACE="${DOCKER_IFACE}"
# Directorio DISTINTO del de prod: una demo abierta a internet no puede tocar los
# CVs de usuarios reales. Los secretos del perfil demo van en cv-creator/.env.demo
# (gitignored): clave de Gemini propia con cuota baja y ALLOW_REGISTRATION=false.
CV_CREATOR_DATA_DIR="/opt/noboolsheet/cv-creator-demo"

#--- CONTROL TOWER (demo pública) ---#
DOCKER_CONTROL_TOWER_APP_DDNS="control-tower.app"
DOCKER_CONTROL_TOWER_WORKER_DDNS="control-tower-worker"
DOCKER_CONTROL_TOWER_DB_DDNS="control-tower-db"
CONTROL_TOWER_APP_EPORT="4274"
CONTROL_TOWER_APP_IPORT="3000"
CONTROL_TOWER_APP_IFACE="${DOCKER_IFACE}"
# Postgres propio, sembrado con una organización ficticia. Los secretos del perfil
# demo van en control-tower/.env.demo (gitignored), SIN claves de integraciones
# reales (Twenty, Notion, GitHub, Google) y con el sync diario desactivado.
CONTROL_TOWER_DATA_DIR="/opt/noboolsheet/control-tower-demo"
