#--- DOCKER (perfil prod: datos REALES, sólo alcanzable por el tailnet) ---#
DOCKER_PROFILE="prod"
DOCKER_NETWORK="noboolsheet_network"
# ⚠ RELLENAR con la IP de Tailscale de vibox (`tailscale ip -4`).
# En la Raspberry Pi esto era "0.0.0.0", que allí daba igual porque la máquina no
# tenía IP pública ni puertos abiertos. vibox SÍ mira a internet: atar el puerto a
# la IP del tailnet es lo que mantiene privadas las apps con datos reales.
# Los deploy scripts se niegan a arrancar en prod mientras ponga CAMBIAME.
DOCKER_IFACE="CAMBIAME.IP.TAILSCALE.VIBOX"

#--- CV-CREATOR ---#
DOCKER_CV_CREATOR_APP_DDNS="cv-creator.app"
CV_CREATOR_APP_EPORT="4242"
CV_CREATOR_APP_IPORT="3000"
CV_CREATOR_APP_IFACE="${DOCKER_IFACE}"
# Datos persistentes (SQLite: usuarios + CVs reales). Bind-mount del host.
CV_CREATOR_DATA_DIR="/opt/noboolsheet/cv-creator"

#--- CONTROL TOWER ---#
DOCKER_CONTROL_TOWER_APP_DDNS="control-tower.app"
DOCKER_CONTROL_TOWER_WORKER_DDNS="control-tower-worker"
DOCKER_CONTROL_TOWER_DB_DDNS="control-tower-db"
CONTROL_TOWER_APP_EPORT="4272"
CONTROL_TOWER_APP_IPORT="3000"
CONTROL_TOWER_APP_IFACE="${DOCKER_IFACE}"
# Datos persistentes de PostgreSQL (datos REALES del negocio).
CONTROL_TOWER_DATA_DIR="/opt/noboolsheet/control-tower"
