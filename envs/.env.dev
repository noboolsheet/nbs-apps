#--- DOCKER (perfil dev: sólo en el Mac) ---#
DOCKER_PROFILE="dev"
DOCKER_NETWORK="noboolsheet_network"
# Sólo loopback: en dev nada tiene por qué verse desde la LAN.
DOCKER_IFACE="127.0.0.1"

#--- CV-CREATOR (SPA Vite + Express + SQLite + Gemini, un solo contenedor) ---#
DOCKER_CV_CREATOR_APP_DDNS="cv-creator.app"
CV_CREATOR_APP_EPORT="4240"
CV_CREATOR_APP_IPORT="3000"
CV_CREATOR_APP_IFACE="${DOCKER_IFACE}"
# En dev la BD va en un volumen Docker con nombre (definido en el compose): así no
# hace falta configurar File Sharing en Docker Desktop para rutas /opt.

#--- CONTROL TOWER (web Next.js + worker + Postgres propio) ---#
DOCKER_CONTROL_TOWER_APP_DDNS="control-tower.app"
DOCKER_CONTROL_TOWER_WORKER_DDNS="control-tower-worker"
DOCKER_CONTROL_TOWER_DB_DDNS="control-tower-db"
CONTROL_TOWER_APP_EPORT="4270"
CONTROL_TOWER_APP_IPORT="3000"
CONTROL_TOWER_APP_IFACE="${DOCKER_IFACE}"
# En dev la DB usa el volumen con nombre ct_pgdata (en el compose).

#--- UNILP (web de muestra: Next.js exportado estático → nginx) ---#
# Sólo perfiles dev (verla en local) y demo (publicarla): nunca tuvo producción.
DOCKER_UNILP_APP_DDNS="unilp.app"
UNILP_APP_EPORT="4210"
UNILP_APP_IPORT="80"
UNILP_APP_IFACE="${DOCKER_IFACE}"

#--- UTCS (web de muestra: SSR; formularios y chatbot desactivados) ---#
DOCKER_UTCS_APP_DDNS="utcs.app"
UTCS_APP_EPORT="4220"
UTCS_APP_IPORT="80"
UTCS_APP_IFACE="${DOCKER_IFACE}"
