# Dependencias y builds
node_modules/
.pnpm-store/
dist/
dist-ssr/
.next/
out/
build/
coverage/
*.tsbuildinfo
.output
.vinxi
.nitro
.tanstack/**

# Secretos: un fichero por perfil (.env.dev / .env.prod / .env.demo), ninguno en git.
# Los envs NO-secreto del repo (puertos, nombres de contenedor) sí se versionan.
.env
.env.*
!.env.example
!envs/.env.dev
!envs/.env.prod
!envs/.env.demo
# Claves de cuentas de servicio: el secreto va en el .env en base64, nunca el JSON.
*-integration.json
*service-account*.json
*.sa.json

# Datos y volcados — jamás al repo
backups/
data/
*.sql.gz
*.dump

# Volcados sueltos.
#
# ⚠ OJO con este patrón: se tragó las 24 migraciones de Drizzle de control-tower.
#   Sólo llegaron a git los meta/*.json, así que el repo tenía un _journal.json
#   listando 24 migraciones y ni un solo .sql. En el portátil no se nota (los
#   ficheros están en disco, sólo que sin trackear); explota al clonar en limpio
#   y desplegar:
#     migration failed: No file .../drizzle/0000_m02_mvp_schema.sql found
#
#   Las migraciones SON código fuente: son lo único que reconstruye el esquema.
#   Por eso van las excepciones de abajo. Si añades una app con migraciones en
#   otra carpeta, añádela aquí.
*.sql
!**/drizzle/*.sql
!**/migrations/*.sql

# Material fuente interno (originales en ../_assets/)
imagen-sources/
images-sources/
image-sources/
images-resources/
docs-sources/
*.docx
*.xlsx
*.pptx
*.HEIC
*.heic

# Test / e2e
playwright-report/
test-results/

# Herramientas de desarrollo (no van al servidor)
.impeccable/
.lovable/
.agents/
skills-lock.json
.claude/settings.local.json

# Sistema operativo / editor
.DS_Store
