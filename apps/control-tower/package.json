{
  "name": "control-tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ct/web dev",
    "build": "pnpm --filter @ct/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @ct/db generate",
    "db:migrate": "pnpm --filter @ct/db migrate",
    "db:seed": "pnpm --filter @ct/db seed",
    "worker": "pnpm --filter @ct/worker start"
  },
  "devDependencies": {
    "@ct/application": "workspace:*",
    "@ct/db": "workspace:*",
    "@ct/integrations": "workspace:*",
    "@ct/shared": "workspace:*",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
