[Unit]
Description=Vaciado semanal de la demo de cv-creator

[Timer]
# Domingo de madrugada: la demo es lo que menos se visita y, si algo falla,
# tienes la semana por delante para verlo.
OnCalendar=Sun *-*-* 04:00:00
# Si la máquina estaba apagada el domingo, se ejecuta al encender en vez de
# saltarse la semana. Sin esto, los CVs de desconocidos se acumularían sin más.
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
