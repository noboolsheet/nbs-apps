# --- Servidor ---
PORT=3000
# Origenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=https://unilp.it,https://test.unilp.it,http://localhost:3000

# Buzon que recibe los mensajes del formulario
CONTACT_TO=tu-correo@gmail.com

# --- Chatbot (n8n) ---
# Webhook INTERNO de n8n al que el backend hace de proxy (ruta POST /chat).
# No es secreto: es una URL interna de shared_network. En prod se define en
# envs/.env.prod y se inyecta via el compose; dejala vacia/sin definir en
# entornos sin n8n (la ruta /chat respondera 503 chat_disabled).
# N8N_CHAT_WEBHOOK_URL=http://n8n.app.prod:5678/webhook/<id>

# --- SMTP de Gmail ---
# Usar una "App Password" de Google (no la contrasena normal de la cuenta).
# Puerto 587 = STARTTLS (SMTP_SECURE=false). Alternativa: 465 con SMTP_SECURE=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password-de-16-caracteres
